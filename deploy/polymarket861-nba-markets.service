[Unit]
Description=Collect independent NBA read-only market evidence

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=-%h/.config/polymarket861-nba/providers.env
ExecStart=%h/.local/share/polymarket861-nba/venv/bin/pm861 --data-dir %h/.local/share/polymarket861-nba/state nba run --component markets
TimeoutStartSec=150s
NoNewPrivileges=yes
