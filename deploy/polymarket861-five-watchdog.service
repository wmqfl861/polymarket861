[Unit]
Description=Check the collector heartbeat and league catalog receipts for the configured fixture window

[Service]
Type=oneshot
Environment=PM861_DATA_DIR=%h/.local/share/polymarket861-five/state
ExecStart=%h/.local/share/polymarket861-five/venv/bin/pm861 market league-watchdog --rolling
TimeoutStartSec=30s
NoNewPrivileges=yes
UMask=0077
